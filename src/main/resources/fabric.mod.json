  },
  "depends": {
    "fabricloader": ">=0.19.0",
    "minecraft": "~26.1.2",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "carpet": "*",
    "jei": "*",
    "roughlyenoughitems": "*",
    "emi": "*"
  }
